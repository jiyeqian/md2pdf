{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "md2pdf-analytics",
  "account_id": "473d684ec9f7f268ae5d462e444c42fa",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "d1_databases": [{ "binding": "DB", "database_name": "md2pdf-analytics", "database_id": "acd905c9-a960-44c4-bc1f-e652f15e7aea", "migrations_dir": "migrations" }],
  "ratelimits": [{ "name": "EVENT_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "triggers": { "crons": ["17 3 * * *"] }
}
